# ---------------------------------------------------------------------------
# Frontend. Copy to .env.local.
# ---------------------------------------------------------------------------

# "mainnet" targets BOT Chain (677). Anything else, including unset, targets Bohr (968).
# The listing bar is mainnet-only, so a production deploy must say mainnet.
NEXT_PUBLIC_BOTCHAIN_NETWORK=testnet

# Optional RPC overrides. The defaults in lib/botchain/chain.ts are the public endpoints.
# NEXT_PUBLIC_BOTCHAIN_RPC=https://rpc.botchain.ai
# NEXT_PUBLIC_BOTCHAIN_WS=wss://ws-rpc.botchain.ai
# NEXT_PUBLIC_BOHR_RPC=https://rpc.bohr.life

# Printed by contracts/script/Deploy.s.sol. Both are required before the UI will transact.
NEXT_PUBLIC_CONTRACT_968=
NEXT_PUBLIC_DEPLOY_BLOCK_968=
NEXT_PUBLIC_CONTRACT_677=
NEXT_PUBLIC_DEPLOY_BLOCK_677=

# Optional. Without it the app is injected-only (MetaMask extension / in-app browser), which is
# enough on desktop. With it, MetaMask on a phone can pair to a desktop page over QR.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Contracts. Used by forge, never shipped to the browser.
# ---------------------------------------------------------------------------

BOTCHAIN_RPC_URL=https://rpc.botchain.ai
BOHR_RPC_URL=https://rpc.bohr.life

# Deployer key. Testnet key for Bohr; the mainnet key holds real BOT and there is no faucet, so
# keep it out of this file and pass it on the command line for the one mainnet run.
DEPLOYER_PRIVATE_KEY=

# Explorer verification. Both explorers run Blockscout — confirmed by verifying Seal on Bohr on
# 2026-10-16. Blockscout ignores the API key but forge insists one is set, and contracts/deploy.sh
# defaults all three, so set these only to point somewhere else.
# BOTSCAN_API_KEY=unset
# BOTSCAN_VERIFIER_URL=https://scan.botchain.ai/api
# BOHR_VERIFIER_URL=https://scan.bohr.life/api
